{
  "name": "3droomdesign-mcp",
  "version": "0.3.2",
  "description": "Local MCP connector for 3D Room Design presets, rendering, video, house tours and CAD",
  "type": "module",
  "license": "UNLICENSED",
  "homepage": "https://3droomdesign.ai",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "3dr": "dist/3dr.js"
  },
  "files": [
    "dist/3dr.js",
    "skills/3dr-media-design/SKILL.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild bin/3dr.js --bundle --platform=node --format=esm --target=node22 --packages=external --external:../package.json --minify --legal-comments=eof --outfile=dist/3dr.js",
    "prepack": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "@napi-rs/keyring": "2.1.2",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "prettier": "3.7.4"
  },
  "repository": {
